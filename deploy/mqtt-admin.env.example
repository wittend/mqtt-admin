# Copy to /etc/mqtt-admin.env, chmod 600, owner root.
MQTT_HOST=<broker-ip>
MQTT_PORT=1883
MQTT_SVC_USER=portal-svc
MQTT_SVC_PASSWORD=change-me
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Networks allowed to reach /admin. Tailscale CGNAT range plus the LAN.
ADMIN_NETS=100.64.0.0/10,<lan-subnet>
# Set to 0 only when testing over plain http on the LAN.
SECURE_COOKIES=1
